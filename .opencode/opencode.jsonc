{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["nvidia", "togetherai", "github-copilot", "minimax"],
  "plugin": [
    "@slkiser/opencode-quota@latest"
    // "@tarquinen/opencode-dcp@latest"
  ],
  "mcp": {
    "ddg": {
      "type": "local",
      "command": [
        "uvx",
        "duckduckgo-mcp-server"
      ],
      "enabled": true
    }
  }
}
